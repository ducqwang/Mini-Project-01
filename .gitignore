# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
env/

# Large model weights (keep folder structure via .gitkeep)
weights/*.pt
weights/*.pth
weights/*.bin
weights/*.onnx
!weights/.gitkeep

# Datasets (large images and annotations)
data/classification/train/*
data/classification/val/*
!data/classification/train/.gitkeep
!data/classification/val/.gitkeep
!data/classification/.gitkeep

data/detection/images/*
data/detection/labels/*
data/detection/_panda_raw/
!data/detection/images/.gitkeep
!data/detection/labels/.gitkeep
!data/detection/.gitkeep

# OS specific files
.DS_Store
Thumbs.db

# IDE configurations
.vscode/
.idea/
